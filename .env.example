# Copy to .env and adjust as needed.
PORT=3000

# Set a long random string in production so sessions survive restarts.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite database file (defaults to data/attendance.db)
DB_FILE=

# Set to "production" to mark session cookies secure (requires HTTPS)
NODE_ENV=
